NODE_ENV=development

# Supermemory
SUPERMEMORY_API_KEY=your-supermemory-api-key
SUPERMEMORY_CONTAINER_TAG_PREFIX=user-
SUPERMEMORY_ENTITY_CONTEXT=Conversation between a user and a chat assistant. Extract stable facts, preferences and plans about the user.

# Local message store (JSON file, see README)
MESSAGES_FILE=./data/messages.json

# Bearer token for the admin routes
ADMIN_TOKEN=change-me

# Long-term memory rollout: comma-separated user ids, or * for everyone
MEMORY_USER_IDS=*

# Temporal memory rollout: "off" or "allowlist"
TEMPORAL_MEMORY=off
TEMPORAL_MEMORY_USER_IDS=
